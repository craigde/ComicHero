# PostgreSQL connection string
# Railway auto-sets this when you add a PostgreSQL plugin
DATABASE_URL="postgresql://user:password@localhost:5432/comichero"

# eBay API credentials (https://developer.ebay.com/)
EBAY_CLIENT_ID="your-ebay-client-id"
EBAY_CLIENT_SECRET="your-ebay-client-secret"

# Comic Vine API key (https://comicvine.gamespot.com/api/)
COMIC_VINE_API_KEY="your-comic-vine-api-key"

# Set to "true" if you have eBay Marketplace Insights API access
EBAY_MARKETPLACE_INSIGHTS_ENABLED="false"
